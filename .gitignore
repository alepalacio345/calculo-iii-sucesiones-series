# Entorno virtual de Python
.venv/

# Estado local de Flet (storage, cache)
.flet/

# Caches redirigidas por run_app.cmd (cliente de escritorio + matplotlib)
.cache/

# Ruedas descargadas (dependencias)
.wheels/

# Descargas temporales del cliente de Flet (no deben versionarse)
flet-windows.zip.*

# Caché de Python
__pycache__/
*.py[cod]

# Documentación generada (pdoc/sphinx)
docs/

# Entornos de desarrollo / sistema operativo
.vscode/
.idea/
Thumbs.db
Desktop.ini
